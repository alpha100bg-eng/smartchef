EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL de l'API FastAPI.
# - Navigateur / web  : http://localhost:8000
# - Téléphone (Expo Go ou dev build) : l'IP LAN du PC, ex. http://192.168.1.43:8000
#   `localhost` depuis un téléphone désigne le téléphone lui-même — tous les
#   appels IA échoueraient. Lancer aussi l'API avec `--host 0.0.0.0`.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Mesure du parcours (PostHog). Facultatif : laissé vide, rien n'est envoyé
# et aucune bibliothèque n'est chargée — c'est l'état par défaut.
# La clé de projet est publique par conception : elle n'autorise que l'envoi
# d'événements, jamais la lecture. Elle peut donc vivre dans le bundle.
# À créer sur eu.posthog.com (région UE : les données restent dans l'Union).
EXPO_PUBLIC_POSTHOG_KEY=
