SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Asymmetric JWT verification (ES256). Public endpoint, e.g.
# https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# IA — Anthropic (vision Sonnet 5 en Phase 1, LLM en Phase 2+)
ANTHROPIC_API_KEY=

# Modèle vision. Défaut = claude-sonnet-5 (meilleur rappel inventaire).
# Repli économique possible : VISION_MODEL=claude-haiku-4-5 (~4,5× moins cher,
# mais ~23 % d'items en moins). Laisser vide = Sonnet 5.
VISION_MODEL=

# Secret partagé pour les jobs cron (nettoyage photos)
CRON_SECRET=
